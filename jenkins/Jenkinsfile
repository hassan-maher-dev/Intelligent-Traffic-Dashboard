
pipeline {
    agent any

    environment {
        // Docker Hub Credentials
        DOCKER_CREDENTIALS_ID = 'dockerhub-creds'
        DOCKER_USERNAME = 'hassanmaher2001'
        APP_NAME_DASHBOARD = 'traffic-dashboard'
        APP_NAME_COLLECTOR = 'traffic-collector'
        IMAGE_TAG = "${BUILD_NUMBER}"
        
        // Git Repository Credentials
        GIT_CREDENTIALS_ID = 'github-creds'
        REPO_URL = 'https://github.com/YOUR_GITHUB_USERNAME/Intelligent-Traffic-Dashboard.git' // غير ده برابط الريبو بتاعك
        GIT_BRANCH = 'main'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    echo "Building Dashboard Image..."
                    sh "docker build -t ${DOCKER_USERNAME}/${APP_NAME_DASHBOARD}:${IMAGE_TAG} -t ${DOCKER_USERNAME}/${APP_NAME_DASHBOARD}:latest ./app/dashboard"
                    
                    echo "Building Collector Image..."
                    sh "docker build -t ${DOCKER_USERNAME}/${APP_NAME_COLLECTOR}:${IMAGE_TAG} -t ${DOCKER_USERNAME}/${APP_NAME_COLLECTOR}:latest ./app/collector"
                }
            }
        }

        stage('Push to Registry') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDENTIALS_ID}", passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME_VAR')]) {
                        sh "echo \$DOCKER_PASSWORD | docker login -u \$DOCKER_USERNAME_VAR --password-stdin"
                        
                        echo "Pushing Dashboard Image..."
                        sh "docker push ${DOCKER_USERNAME}/${APP_NAME_DASHBOARD}:${IMAGE_TAG}"
                        sh "docker push ${DOCKER_USERNAME}/${APP_NAME_DASHBOARD}:latest"
                        
                        echo "Pushing Collector Image..."
                        sh "docker push ${DOCKER_USERNAME}/${APP_NAME_COLLECTOR}:${IMAGE_TAG}"
                        sh "docker push ${DOCKER_USERNAME}/${APP_NAME_COLLECTOR}:latest"
                    }
                }
            }
        }

        stage('Update GitOps Manifests') {
            steps {
                script {
                    echo "Updating Kubernetes Manifests with new Image Tags..."
                    
                    sh """
                        git config user.email "jenkins@hassanmaher.tech"
                        git config user.name "Jenkins CI"
                    """

                    sh """
                        sed -i "s|image: ${DOCKER_USERNAME}/${APP_NAME_DASHBOARD}:.*|image: ${DOCKER_USERNAME}/${APP_NAME_DASHBOARD}:${IMAGE_TAG}|g" k8s/application/deployment-dashboard.yaml
                        sed -i "s|image: ${DOCKER_USERNAME}/${APP_NAME_COLLECTOR}:.*|image: ${DOCKER_USERNAME}/${APP_NAME_COLLECTOR}:${IMAGE_TAG}|g" k8s/application/deployment-collector.yaml
                    """

                    withCredentials([usernamePassword(credentialsId: "${GIT_CREDENTIALS_ID}", passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
                        sh """
                            git add k8s/application/deployment-dashboard.yaml
                            git add k8s/application/deployment-collector.yaml
                            
                            # نتأكد إن فيه تغيير حصل فعلاً عشان الـ Pipeline ميضربش
                            if ! git diff --cached --quiet; then
                                git commit -m "Update image tags to ${IMAGE_TAG} [skip ci]"
                                git push https://${GIT_USERNAME}:${GIT_PASSWORD}@${REPO_URL#https://} HEAD:${GIT_BRANCH}
                            else
                                echo "No changes to commit"
                            fi
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "CI Pipeline Completed Successfully! ArgoCD will now sync the new images."
        }
        failure {
            echo "CI Pipeline Failed. Please check the logs."
        }
    }
}